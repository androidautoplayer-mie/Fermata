<?xml version="1.0" encoding="utf-8"?>
<resources>

    <style name="AppTheme.Light">

        <item name="android:colorBackground">#FFFFFF</item>

        <!-- Matte black navigation and toolbar -->
        <item name="colorPrimaryDark">#25272B</item>
        <item name="colorPrimary">?colorPrimaryDark</item>
        <item name="colorOnPrimary">#7CFC00</item>
        <item name="android:textColorPrimary">#202124</item>

        <!-- Clean white surfaces with dark readable text -->
        <item name="colorSecondary">#FFFFFF</item>
        <item name="colorOnSecondary">#202124</item>
        <item name="android:textColorSecondary">#555A61</item>
        <item name="boxStrokeColor">#AEB3BA</item>

        <item name="alpha">1</item>
        <item name="colorSecondaryVariant">#7CFC00</item>
        <item name="android:textColorTertiary">#FFFFFF</item>

        <item name="colorSurface">?colorPrimary</item>
        <item name="colorOnSurface">#F5F6F7</item>
        <item name="colorPrimarySurface">?colorPrimary</item>
        <item name="colorOnPrimarySurface">#F5F6F7</item>
        <item name="popupMenuStyle">@style/AppTheme.Light.PopupMenuStyle</item>

        <item name="colorAccent">#7CFC00</item>
        <item name="rippleColor">?colorAccent</item>
        <item name="android:textColorHint">#858A94</item>
        <item name="colorControlNormal">#555A61</item>
        <item name="colorControlActivated">#7CFC00</item>

    </style>

    <style name="AppTheme.Light.PopupMenuStyle" parent="Theme.Utils.Base.PopupMenuStyle">
        <item name="android:textColor">#F5F6F7</item>
    </style>

</resources>
